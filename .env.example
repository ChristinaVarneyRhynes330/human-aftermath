NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 32+ random characters: openssl rand -hex 32
CREDENTIAL_SIGNING_SECRET=

# PHASE 1 LAUNCH FLAGS
# Set both to false in every initial deployment. Never enable course access
# until paid entitlements, certificates and private-media security are complete.
COURSE_ACCESS_OPEN=false
# Set to true only when Supabase, anti-spam and business privacy contact are ready.
WAITLIST_ENABLED=false
# Required for live waitlist; site key is public, secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Public contact address shown on the privacy notice, required before public signup.
PUBLIC_CONTACT_EMAIL=
# Suggested: configure rate limiting / bot protection before public signups.
